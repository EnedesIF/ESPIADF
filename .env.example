# Copie para .env.local e preencha para ativar o Supabase.
# Sem estas variáveis o jogo roda em MODO LOCAL (dados salvos no navegador).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# PIN da área ADMIN no modo local (apenas demonstração; em produção use papel 'admin' no Supabase).
VITE_ADMIN_PIN=enedes-admin
